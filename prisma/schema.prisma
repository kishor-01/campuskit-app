generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  username           String?         @unique
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  education          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  role               Role            @default(VIEWER)
  deletedAt          DateTime?
  permissions        Permission[]
  backupCodes        String[]        @default([])
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  totpEnabled        Boolean         @default(false)
  totpSecret         String?
  sessionVersion     Int             @default(0)
  lockedUntil        DateTime?
  accounts           Account[]
  articles           Article[]       @relation("ArticleAuthor")
  goals              Goal[]
  submittedResources Resource[]      @relation("UserSubmissions")
  savedResources     SavedResource[]
  savedArticles      SavedArticle[]
  sessions           Session[]
  portfolioAudits    PortfolioAudit[]
  notifications      Notification[]
  resourceSubmissions ResourceSubmission[]
  currentStreak      Int             @default(0)
  longestStreak      Int             @default(0)
  lastActiveAt       DateTime?

  // Developer Passport
  developerTitle     String          @default("Initiate")
  badges             String[]        @default([])
  githubUrl          String?
  portfolioUrl       String?
  bio                String?
  isPublicProfile    Boolean         @default(true)
  showHeatmap        Boolean         @default(true)
  allowEmails        Boolean         @default(true)
  onboarded          Boolean         @default(false)
  domain             String?
  objective          String?
  roadmapStepCompletions UserRoadmapStepCompletion[]
  missionPlans           UserMissionPlan[]
  stepNotes              UserStepNote[]
  customSteps            UserCustomStep[]
  nodePositions          UserNodePosition[]
  lifemapNodes           LifemapNode[]
  lifemapEdges           LifemapEdge[]
  nodeProgress           UserNodeProgress[]
  nodeNotes              UserNodeNote[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model Resource {
  id                 String                @id @default(cuid())
  name               String
  description        String
  url                String                @unique
  imageUrl           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  status             ResourceStatus        @default(PENDING)
  categoryId         String
  submittedById      String?
  highlights         Json?
  prerequisites      Json?
  steps              Json?
  visualizations     Json?
  difficultyTier     DifficultyTier        @default(INTERMEDIATE)
  seniorInsight      String                @default("Pending senior insight")
  healthStatus       ResourceHealth        @default(HEALTHY)
  timeRequired       String?               @default("2-4 Hours")
  publishedAt        DateTime              @default(now())
  authorOverride     String?
  linkedToGoals      GoalResource[]
  category           Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  submittedBy        User?                 @relation("UserSubmissions", fields: [submittedById], references: [id])
  partOfRoadmapSteps RoadmapStepResource[]
  savedByUsers       SavedResource[]
  linkedToTopics     TopicResource[]
}

model Category {
  id                 String               @id @default(cuid())
  name               String               @unique
  icon               String?
  slug               String               @unique
  Opportunity        Opportunity[]
  resources          Resource[]
  resourceSubmissions ResourceSubmission[]
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(UNREAD)
  createdAt DateTime             @default(now())
}

enum ContactMessageStatus {
  UNREAD
  READ
}

model ContentReport {
  id          String              @id @default(cuid())
  reporterId  String?
  contentType String              // 'ROADMAP', 'RESOURCE', 'ARTICLE', 'OPPORTUNITY'
  contentId   String
  reason      String
  status      ContentReportStatus @default(PENDING)
  createdAt   DateTime            @default(now())
}

enum ContentReportStatus {
  PENDING
  REVIEWED
}

model Opportunity {
  id             String            @id @default(cuid())
  title          String
  organization   String
  location       String
  type           OpportunityType
  description    String
  applyUrl       String            @unique
  imageUrl       String?
  visualizations Json?
  startDate      DateTime?
  endDate        DateTime?
  status         OpportunityStatus @default(PUBLISHED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  publishedAt    DateTime          @default(now())
  authorOverride String?
  categoryId     String
  Category       Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Phase 2: Strategic metadata
  tier           OpportunityTier   @default(TIER_3)
  difficulty     DifficultyTier    @default(INTERMEDIATE)
  stipendRange   String?           // e.g., "₹20k - ₹50k" or "Unpaid"
  duration       String?           // e.g., "2 Months", "6 Months"
  skillsRequired String[]          // Array of skill tags for filtering
  seniorInsight  String            @default("Focus on building a strong portfolio to stand out.")
  prepResources  String[]          // Links to internal/external prep guides
  isRemote       Boolean           @default(false)
}

model Article {
  id                String         @id @default(cuid())
  title             String
  slug              String         @unique
  content           String
  excerpt           String
  imageUrl          String?
  status            ArticleStatus  @default(DRAFT)
  authorId          String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  publishedAt       DateTime       @default(now())
  authorOverride    String?
  readTimeMins      Int            @default(5)
  seriesId          String?
  seriesOrder       Int?
  tags              String[]
  hasInteractiveEnv Boolean        @default(false)
  clonableBlueprint Json?

  author            User           @relation("ArticleAuthor", fields: [authorId], references: [id])
  series            ArticleSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  savedByUsers      SavedArticle[]
}

model ArticleSeries {
  id          String    @id @default(cuid())
  title       String    @unique
  slug        String    @unique
  description String
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model SavedArticle {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
}

model Roadmap {
  id             String          @id @default(cuid())
  title          String          @unique
  slug           String          @unique
  description    String
  imageUrl       String?
  isPublished    Boolean         @default(false)
  difficultyTier DifficultyTier  @default(INTERMEDIATE)
  seniorInsight  String          @default("Pending senior insight")
  estimatedHours Int?
  prerequisites  String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  steps          RoadmapStep[]
  branches       RoadmapBranch[]
  missionPlans   UserMissionPlan[]
  customSteps    UserCustomStep[]
  learningNodes  LearningNode[]
  learningEdges  LearningEdge[]
}

model RoadmapBranch {
  id          String        @id @default(cuid())
  title       String
  description String?
  order       Int
  color       String?
  roadmapId   String
  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  steps       RoadmapStep[]

  @@unique([roadmapId, order])
}

model RoadmapStep {
  id              String                @id @default(cuid())
  title           String
  description     String
  order           Int
  roadmapId       String
  branchId        String?
  deepDiveUrl     String?
  quickRefUrl     String?
  roadmap         Roadmap               @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  branch          RoadmapBranch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  linkedResources RoadmapStepResource[]
  completions     UserRoadmapStepCompletion[]
  notes           UserStepNote[]

  @@unique([roadmapId, order])
}

model RoadmapStepResource {
  roadmapStepId String
  resourceId    String
  resource      Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@id([roadmapStepId, resourceId])
}

model Goal {
  id               String      @id @default(cuid())
  title            String
  targetDate       DateTime?
  userId           String
  isTemplate       Boolean     @default(false)
  currentStreak    Int         @default(0)
  longestStreak    Int         @default(0)
  lastActivityDate DateTime?
  totalFocusTime   Int         @default(0)
  priority         Priority    @default(MEDIUM)
  aiStudyPlan      Json?
  sourceRoadmapId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones       Milestone[]
}

model Milestone {
  id     String  @id @default(cuid())
  title  String
  order  Int
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@unique([goalId, order])
}

model Topic {
  id              String          @id @default(cuid())
  title           String
  order           Int
  milestoneId     String
  note            String?
  subTopics       SubTopic[]
  milestone       Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  linkedResources TopicResource[]

  @@unique([milestoneId, order])
}

model SubTopic {
  id              String         @id @default(cuid())
  title           String
  order           Int
  isCompleted     Boolean        @default(false)
  completedAt     DateTime?
  topicId         String
  note            String?
  linkedResources GoalResource[]
  topic           Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, order])
}

model GoalResource {
  id           String   @id @default(cuid())
  personalNote String?
  subTopicId   String
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  subTopic     SubTopic @relation(fields: [subTopicId], references: [id], onDelete: Cascade)

  @@unique([subTopicId, resourceId])
}

model TopicResource {
  id           String   @id @default(cuid())
  personalNote String?
  topicId      String
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, resourceId])
}

model SavedResource {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AffiliatePartner {
  id          String          @id @default(cuid())
  name        String          @unique
  website     String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  links       AffiliateLink[]
}

model AffiliateLink {
  id        String           @id @default(cuid())
  name      String
  url       String           @unique
  slug      String           @unique
  partnerId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  createdAt    DateTime @default(now())
  confirmed    Boolean  @default(false)
  confirmToken String?  @unique

  @@index([email])
}

model csrf_tokens {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model email_change_requests {
  id        String   @id
  userId    String
  oldEmail  String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model failed_login_attempts {
  id          String   @id
  identifier  String
  ip          String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  @@index([attemptedAt])
  @@index([identifier])
}

model password_history {
  id           String   @id
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model security_audit_log {
  id        String   @id
  userId    String?
  eventType String
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
}

enum OtpType {
  SIGNUP
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum Permission {
  CONTENT_READ
  CONTENT_WRITE
  CONTENT_MODERATE
  CONTENT_DELETE
  USER_READ
  USER_MANAGE
  AFFILIATE_READ
  AFFILIATE_MANAGE
  BLOG_READ
  BLOG_WRITE
  BLOG_PUBLISH
  BLOG_DELETE
  RESOURCE_READ
  RESOURCE_WRITE
  RESOURCE_MODERATE
  RESOURCE_DELETE
  OPPORTUNITY_READ
  OPPORTUNITY_WRITE
  OPPORTUNITY_MODERATE
  OPPORTUNITY_DELETE
  ROADMAP_READ
  ROADMAP_WRITE
  ROADMAP_PUBLISH
  ROADMAP_DELETE
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

model ResourceSubmission {
  id          String         @id @default(cuid())
  title       String
  url         String
  description String
  status      ResourceStatus @default(PENDING)
  userId      String
  categoryId  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  HACKATHON
  WORKSHOP
  SEMINAR
  SCHOLARSHIP
  COMPETITION
  DEAL
  GRANT
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum OpportunityStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum OpportunityTier {
  TIER_1 // FAANG, Top Research, Global Scholarships (e.g., GSoC, Google STEP)
  TIER_2 // High-growth Startups, Mid-size Tech, National Competitions
  TIER_3 // General Internships, Local Workshops, Early-stage startups
}

enum DifficultyTier {
  BEGINNER
  INTERMEDIATE
  SENIOR
}

enum ResourceHealth {
  HEALTHY
  WARNING
  DEAD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PortfolioAudit {
  id                 String   @id @default(cuid())
  userId             String
  githubUrl          String
  readabilityScore   Int?
  architectureScore  Int?
  securityScore      Int?
  actionableRefactor String?
  feedback           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // e.g., "ROADMAP_CLONED", "PROJECT_GENERATED", "ATS_USED", "HERO_SEARCH"
  userId      String?  // Optional: Null if anonymous user
  metadata    Json?    // e.g., {"skill": "Rust", "tier": "TIER_1"}
  createdAt   DateTime @default(now())

  @@index([eventType, createdAt]) // Crucial for fast dashboard querying
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum NotificationType {
  SYSTEM
  COMMUNITY
  ACHIEVEMENT
}

model UserRoadmapStepCompletion {
  id            String      @id @default(cuid())
  userId        String
  roadmapStepId String
  completedAt   DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapStepId])
  @@index([userId])
  @@index([roadmapStepId])
  @@map("user_roadmap_step_completions")
}

model UserMissionPlan {
  id              String      @id @default(cuid())
  userId          String
  roadmapId       String
  roadmapStepIds  String[]    // Custom ordered roadmapStep IDs in Active Mission
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap         Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
  @@index([roadmapId])
  @@map("user_mission_plans")
}

model UserStepNote {
  id            String          @id @default(cuid())
  userId        String
  roadmapStepId String?
  customStepId  String?
  roadmapId     String?
  positionX     Float?
  positionY     Float?
  color         String?         @default("yellow")
  content       String          @db.Text
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapStep   RoadmapStep?    @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  customStep    UserCustomStep? @relation(fields: [customStepId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapStepId])
  @@unique([userId, customStepId])
  @@index([userId])
  @@index([roadmapStepId])
  @@index([customStepId])
  @@index([roadmapId])
  @@map("user_step_notes")
}

model UserCustomStep {
  id          String         @id @default(cuid())
  userId      String
  roadmapId   String
  title       String
  theory      String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  notes       UserStepNote[]

  @@index([userId])
  @@index([roadmapId])
  @@map("user_custom_steps")
}

model UserNodePosition {
  id            String   @id @default(cuid())
  userId        String
  roadmapId     String
  stepId        String   // Can represent either a standard roadmapStepId or a userCustomStepId
  positionX     Float
  positionY     Float
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId, stepId])
  @@index([userId])
  @@index([roadmapId])
  @@map("user_node_positions")
}

model LifemapNode {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?       @db.Text
  targetDate    DateTime
  tags          String[]
  colorTheme    String        @default("indigo")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingEdges LifemapEdge[] @relation("EdgeSource")
  incomingEdges LifemapEdge[] @relation("EdgeTarget")

  @@index([userId])
  @@index([targetDate])
  @@map("lifemap_nodes")
}

model LifemapEdge {
  id        String   @id @default(cuid())
  userId    String
  sourceId  String
  targetId  String
  createdAt DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    LifemapNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    LifemapNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, targetId])
  @@index([userId])
  @@index([sourceId])
  @@index([targetId])
  @@map("lifemap_edges")
}

// ─────────────────────────────────────────────────────────────────────────────
// ROADMAP V2 — Constellation Engine (DAG Architecture)
// ─────────────────────────────────────────────────────────────────────────────

enum NodeProgressStatus {
  LOCKED
  UNLOCKED
  COMPLETED
}

model LearningNode {
  id            String        @id @default(cuid())
  roadmapId     String
  title         String
  briefing      String        @db.Text
  type          String        @default("concept") // 'concept' | 'practice' | 'milestone'
  positionX     Float         @default(0)
  positionY     Float         @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  roadmap       Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  outgoingEdges LearningEdge[] @relation("LearningEdgeSource")
  incomingEdges LearningEdge[] @relation("LearningEdgeTarget")
  userProgress       UserNodeProgress[]
  userNotes          UserNodeNote[]
  affiliateResources AffiliateResource[]

  @@index([roadmapId])
  @@map("learning_nodes")
}

model LearningEdge {
  id           String       @id @default(cuid())
  roadmapId    String
  sourceNodeId String
  targetNodeId String

  roadmap      Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  source       LearningNode @relation("LearningEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       LearningNode @relation("LearningEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([roadmapId])
  @@map("learning_edges")
}

model UserNodeProgress {
  id          String             @id @default(cuid())
  userId      String
  nodeId      String
  status      NodeProgressStatus @default(LOCKED)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  node        LearningNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
  @@map("user_node_progress")
}

// ─── V2 Cloud Note Sync ───────────────────────────────────────────────────────

model UserNodeNote {
  id        String       @id @default(cuid())
  userId    String
  nodeId    String
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      LearningNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
  @@map("user_node_notes")
}

// ─── V2 Affiliate Arsenal ─────────────────────────────────────────────────────

enum AffiliateResourceType {
  COURSE
  BOOK
  TOOL
  ARTICLE
}

model AffiliateResource {
  id          String                @id @default(cuid())
  nodeId      String
  title       String
  description String
  url         String
  type        AffiliateResourceType @default(COURSE)
  isPremium   Boolean               @default(false)
  createdAt   DateTime              @default(now())

  node        LearningNode          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@map("affiliate_resources")
}

