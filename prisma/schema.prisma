generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      OtpType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
  @@index([expiresAt])
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  username           String?         @unique
  email              String?         @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  education          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  role               Role            @default(VIEWER)
  accounts           Account[]
  articles           Article[]       @relation("ArticleAuthor")
  goals              Goal[]
  submittedResources Resource[]      @relation("UserSubmissions")
  savedResources     SavedResource[]
  sessions           Session[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model Resource {
  id                 String                @id @default(cuid())
  name               String
  description        String
  url                String
  imageUrl           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  status             ResourceStatus        @default(PENDING)
  categoryId         String
  submittedById      String?
  linkedToGoals      GoalResource[]
  category           Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  submittedBy        User?                 @relation("UserSubmissions", fields: [submittedById], references: [id])
  partOfRoadmapSteps RoadmapStepResource[]
  savedByUsers       SavedResource[]
  linkedToTopics     TopicResource[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  resources Resource[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Opportunity {
  id           String            @id @default(cuid())
  title        String
  organization String
  location     String
  type         OpportunityType
  description  String
  applyUrl     String
  imageUrl     String?
  startDate    DateTime?
  endDate      DateTime?
  status       OpportunityStatus @default(PUBLISHED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Article {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  content   String
  excerpt   String
  imageUrl  String?
  status    ArticleStatus @default(DRAFT)
  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation("ArticleAuthor", fields: [authorId], references: [id])
}

model Roadmap {
  id          String        @id @default(cuid())
  title       String        @unique
  slug        String        @unique
  description String
  imageUrl    String?
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  steps       RoadmapStep[]
}

model RoadmapStep {
  id              String                @id @default(cuid())
  title           String
  description     String
  order           Int
  roadmapId       String
  roadmap         Roadmap               @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  linkedResources RoadmapStepResource[]

  @@unique([roadmapId, order])
}

model RoadmapStepResource {
  roadmapStepId String
  resourceId    String
  resource      Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)

  @@id([roadmapStepId, resourceId])
}

model Goal {
  id         String      @id @default(cuid())
  title      String
  targetDate DateTime?
  userId     String
  isTemplate Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]
}

model Milestone {
  id     String  @id @default(cuid())
  title  String
  order  Int
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@unique([goalId, order])
}

model Topic {
  id              String          @id @default(cuid())
  title           String
  order           Int
  milestoneId     String
  note            String?
  subTopics       SubTopic[]
  milestone       Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  linkedResources TopicResource[]

  @@unique([milestoneId, order])
}

model SubTopic {
  id              String         @id @default(cuid())
  title           String
  order           Int
  isCompleted     Boolean        @default(false)
  topicId         String
  note            String?
  linkedResources GoalResource[]
  topic           Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, order])
}

model GoalResource {
  id           String   @id @default(cuid())
  personalNote String?
  subTopicId   String
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  subTopic     SubTopic @relation(fields: [subTopicId], references: [id], onDelete: Cascade)

  @@unique([subTopicId, resourceId])
}

model TopicResource {
  id           String   @id @default(cuid())
  personalNote String?
  topicId      String
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, resourceId])
}

model SavedResource {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AffiliatePartner {
  id          String          @id @default(cuid())
  name        String          @unique
  website     String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  links       AffiliateLink[]
}

model AffiliateLink {
  id        String           @id @default(cuid())
  name      String
  url       String           @unique
  slug      String           @unique
  partnerId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  createdAt    DateTime @default(now())
  confirmed    Boolean  @default(false)
  confirmToken String?  @unique

  @@index([email])
}

enum OtpType {
  SIGNUP
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum Permission {
  CONTENT_READ
  CONTENT_WRITE
  CONTENT_MODERATE
  CONTENT_DELETE
  USER_READ
  USER_MANAGE
  AFFILIATE_READ
  AFFILIATE_MANAGE
  BLOG_READ
  BLOG_WRITE
  BLOG_PUBLISH
  BLOG_DELETE
  RESOURCE_READ
  RESOURCE_WRITE
  RESOURCE_MODERATE
  RESOURCE_DELETE
  OPPORTUNITY_READ
  OPPORTUNITY_WRITE
  OPPORTUNITY_MODERATE
  OPPORTUNITY_DELETE
  ROADMAP_READ
  ROADMAP_WRITE
  ROADMAP_PUBLISH
  ROADMAP_DELETE
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  HACKATHON
  WORKSHOP
  SEMINAR
  SCHOLARSHIP
  COMPETITION
  DEAL
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum OpportunityStatus {
  PENDING
  PUBLISHED
  REJECTED
}
