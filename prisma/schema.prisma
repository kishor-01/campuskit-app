// prisma/schema.prisma

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// --- New Enum Definitions
// ------------------------------------------

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

// ------------------------------------------
// --- Main Application Models
// ------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String?
  username         String?   @unique
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  education        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // NEW: Add a role to identify admins
  isAdmin          Boolean   @default(false)

  // Relations
  accounts           Account[]
  sessions           Session[]
  savedResources     SavedResource[]
  submittedResources Resource[]      @relation("UserSubmissions")
}

model Resource {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  url           String
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // NEW: Add a status field for moderation
  status        ResourceStatus @default(PENDING)

  // Relation to Category
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Relation to Users who have saved this resource
  savedByUsers SavedResource[]

  // Relation to the User who submitted this resource
  submittedBy   User?   @relation("UserSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedById String?
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  resources Resource[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ------------------------------------------
// --- Join Table for Many-to-Many Relations
// ------------------------------------------

model SavedResource {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  // Relations to the other tables
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // This ensures a user can only save a specific resource one time
  @@id([userId, resourceId])
}

// ------------------------------------------
// --- Auth Models (Required by NextAuth.js)
// ------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// NEW: Add this model for the Perks & Deals feature
model Deal {
  id           String   @id @default(cuid())
  title        String   // e.g., "6 Months of Spotify Premium Free"
  company      String   // e.g., "Spotify"
  description  String   @db.Text
  affiliateUrl String
  imageUrl     String?
  category     String   // e.g., "Software", "Services", "Hardware"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}