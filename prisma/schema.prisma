generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---
enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpportunityType {
  INTERNSHIP
  FULL_TIME
  HACKATHON
  WORKSHOP
  SEMINAR
  SCHOLARSHIP
  COMPETITION
  DEAL
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum OpportunityStatus {
  PENDING
  PUBLISHED
  REJECTED
}

// --- Main Application Models ---
model User {
  id                 String    @id @default(cuid())
  name               String?
  username           String?   @unique
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  education          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isAdmin            Boolean   @default(false)

  accounts           Account[]
  sessions           Session[]
  savedResources     SavedResource[]
  submittedResources Resource[]      @relation("UserSubmissions")
  articles           Article[]       @relation("ArticleAuthor")
  goals              Goal[]          // ADDED: Goal Architect relation
}

model Resource {
  id            String         @id @default(cuid())
  name          String
  description   String         @db.Text
  url           String
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        ResourceStatus @default(PENDING)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  savedByUsers  SavedResource[]
  submittedBy   User?          @relation("UserSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedById String?
  
  // This is the other side of the many-to-many relationship
  partOfRoadmapSteps RoadmapStepResource[]
  linkedToGoals      GoalResource[] // ADDED: Goal Architect relation
  linkedToTopics     TopicResource[] // ADDED: Topic -> Resource relation
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  resources Resource[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Opportunity {
  id           String           @id @default(cuid())
  title        String
  organization String
  location     String
  type         OpportunityType
  description  String           @db.Text
  applyUrl     String
  imageUrl     String?
  startDate    DateTime?
  endDate      DateTime?
  status       OpportunityStatus @default(PUBLISHED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Article {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  content   String        @db.Text
  excerpt   String        @db.Text
  imageUrl  String?
  status    ArticleStatus @default(DRAFT)

  author    User          @relation("ArticleAuthor", fields: [authorId], references: [id])
  authorId  String

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// --- Roadmap Hub Models ---
model Roadmap {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?
  isPublished Boolean  @default(false)
  
  steps       RoadmapStep[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model RoadmapStep {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  order       Int      // To define the sequence (1, 2, 3...)

  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  // This creates the many-to-many link to our existing Resource model
  linkedResources RoadmapStepResource[]

  @@unique([roadmapId, order])
}

// This is the "join table" connecting a step to multiple resources
model RoadmapStepResource {
  roadmapStepId String
  resourceId    String

  roadmapStep   RoadmapStep @relation(fields: [roadmapStepId], references: [id], onDelete: Cascade)
  resource      Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([roadmapStepId, resourceId])
}

// --- Goal Architect Models ---
model Goal {
  id          String   @id @default(cuid())
  title       String
  targetDate  DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // For the Goal Templates feature
  isTemplate  Boolean  @default(false)
  
  milestones  Milestone[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Milestone {
  id        String   @id @default(cuid())
  title     String   // e.g., "Data Structures & Algorithms"
  order     Int      // For reordering
  
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  topics    Topic[]
  
  @@unique([goalId, order])
}

model Topic {
  id          String    @id @default(cuid())
  title       String    // e.g., "Sorting Algorithms"
  order       Int
  
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  subTopics   SubTopic[]

  // NEW: general editor note for the topic
  note        String?   @db.Text

  // NEW: linked resources for topic
  linkedResources TopicResource[]

  @@unique([milestoneId, order])
}

model SubTopic {
  id          String  @id @default(cuid())
  title       String  // e.g., "Quicksort"
  order       Int
  isCompleted Boolean @default(false) // For progress tracking
  
  topicId     String
  topic       Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  linkedResources GoalResource[]

  // NEW: general editor note for the subtopic
  note        String? @db.Text

  @@unique([topicId, order])
}

// Join table for linking resources to sub-topics with a personal note
model GoalResource {
  id           String  @id @default(cuid())
  personalNote String? @db.Text

  subTopicId   String
  subTopic     SubTopic @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  
  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([subTopicId, resourceId])
}

// NEW: join table for linking resources to topics (with personal note)
model TopicResource {
  id           String  @id @default(cuid())
  personalNote String? @db.Text

  topicId      String
  topic        Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  resourceId   String
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([topicId, resourceId])
}

// --- Join Table ---
model SavedResource {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}

// --- Auth Models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Affiliate engine models
model AffiliatePartner {
  id          String         @id @default(cuid())
  name        String         @unique
  website     String
  description String?
  
  links       AffiliateLink[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

model AffiliateLink {
  id          String   @id @default(cuid())
  name        String
  url         String   @unique
  slug        String   @unique
  
  partnerId   String
  partner     AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
